# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (Shannons_diary)
# ==============================================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend FastAPI URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Shared judge demo account. Create it with:
#   cd Shannons_diary/backend && .venv/Scripts/python.exe ../database/seed_demo_user.py
# The Judge Demo button signs into this account for real, so it must hold no
# data you would show a stranger. Gitignored .env only - never commit these.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
