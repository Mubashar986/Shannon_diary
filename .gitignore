# ==============================================================================
# HACKATHON ROOT .GITIGNORE
# Protects secrets, credentials, build artifacts, and heavy dependencies
# ==============================================================================

# Environment and Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
!.env.example

# Dependencies
node_modules/
**/node_modules/
.venv/
**/.venv/
env/
venv/
ENV/

# Python cache & bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Frontend Build & Bundles
dist/
**/dist/
build/
**/build/
out/
.next/

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
